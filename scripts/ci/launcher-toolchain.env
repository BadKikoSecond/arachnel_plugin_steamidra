# Mirror of Arachnel .github/workflows/release.yml Qt/toolchain pins.
# Local PC kit: D:\Qt\6.11.1\mingw_64
QT_VERSION=6.11.1
QT_WINDOWS_ARCH=win64_mingw
QT_WINDOWS_KIT=mingw_64
QT_LINUX_ARCH=linux_gcc_64
QT_MODULES=qtshadertools qtmultimedia
BUILD_TYPE=Release
# Plugin API v4 lives on Arachnel develop until the next tagged release ships it.
# After that cut, pin to the release tag (e.g. v0.1.35).
ARACHNEL_SDK_REF=develop
# Sourcelist compatibility range for this plugin build.
MIN_ARACHNEL=0.1.34
MAX_ARACHNEL=
