# Mirror of Arachnel .github/workflows/release.yml Qt/toolchain pins.
QT_VERSION=6.8.2
QT_WINDOWS_ARCH=win64_msvc2022_64
QT_LINUX_ARCH=linux_gcc_64
QT_MODULES=qtshadertools qtmultimedia
BUILD_TYPE=Release
# Plugin API v3 (owns_download) is on feature/new_plugin_sdk until the next Arachnel release tag.
ARACHNEL_SDK_REF=feature/new_plugin_sdk
